{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests",
      "type": "shell",
      "command": "cargo test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Server starten",
      "type": "shell",
      "command": "cargo run -p doeverything-server",
      "isBackground": true,
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Server im Container (podman)",
      "type": "shell",
      "command": "podman compose up --build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Container stoppen",
      "type": "shell",
      "command": "podman compose down",
      "problemMatcher": []
    }
  ]
}
