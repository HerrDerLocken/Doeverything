{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests",
      "type": "shell",
      "command": "cargo test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Tests (inkl. Verschlüsselung)",
      "type": "shell",
      "command": "cargo test --all-features",
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Server starten",
      "type": "shell",
      "command": "cargo run -p doeverything-server",
      "isBackground": true,
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Server im Container (podman)",
      "type": "shell",
      "command": "podman compose up --build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Container stoppen",
      "type": "shell",
      "command": "podman compose down",
      "problemMatcher": []
    },
    {
      "label": "App: Dart-Bindings neu erzeugen",
      "type": "shell",
      "command": "flutter_rust_bridge_codegen generate",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "problemMatcher": []
    },
    {
      "label": "App: Integrationstest (Linux)",
      "type": "shell",
      "command": "flutter test integration_test -d linux",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
